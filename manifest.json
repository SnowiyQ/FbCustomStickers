{
  "manifest_version": 3,
  "name": "Custom Stickers for Messenger",
  "version": "1.3.0",
  "description": "Send your own images and stickers from GIPHY, LINE or any website as custom Messenger stickers on desktop.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "My Messenger stickers"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.messenger.com/*"],
      "js": ["src/page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.messenger.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
